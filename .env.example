# Confío Pagos (dev: https://api.dev.confiopagos.com, prod: https://api.confiopagos.com)
CONFIO_API_URL=https://api.dev.confiopagos.com
CONFIO_ACCESS_TOKEN=
# Store id (the "<id>" part of "stores/<id>" returned by GET /v1/stores)
CONFIO_STORE_ID=
# WEBHOOK_KEY agreed with Confío; sent as "Authorization: Bearer <key>" on webhooks
CONFIO_WEBHOOK_SECRET=

# Supabase (server-side only, never expose the service role key to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel
ADMIN_PASSWORD=
# At least 32 random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# Public base URL of this app, without trailing slash
APP_URL=http://localhost:3000

# Set to 1 only for CI/builds without real secrets (skips env validation)
# SKIP_ENV_VALIDATION=1
